# قاعدة البيانات (MySQL 8)
DATABASE_URL="mysql://kafaat:CHANGE_ME@localhost:3306/kafaat"
# سر التطبيق: يُستخدم لتوقيع الجلسات وتشفير مفاتيح بوابات الدفع ومفتاح Claude المحفوظ في الإعدادات (32 حرفاً على الأقل)
